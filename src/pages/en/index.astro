---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Shot from '@/components/Shot.astro';
import { Image } from 'astro:assets';
import { site as site } from '@/data/site.en';
import { photo } from '@/lib/photos';
import { withBase } from '@/lib/url';
import logoAmf from '@/assets/photos/logo-amf.png.svg';

const p = site.person;
const portrait = photo('portrait-transparent-2');
const logos = {
  csa: photo('logo csa blanc'),
  havas: photo('Havas'),
  kantar: photo('Logo_Kantar_noir'),
  ehess: photo('EHESS logo blanc_0.png'),
  berlin: photo('Logo_der_Technischen_Universität_Berlin.svg'),
  strasbourg: photo('Université_de_Strasbourg.svg'),
};

const boxes = [
  { title: 'Research & analysis tools', items: [...site.analysisTools] as string[] },
  { title: 'Creative tools', items: [...site.creativeTools] as string[] },
  { title: 'Languages', items: site.languages.map((l) => `${l.name} · ${l.level}`) },
];

const introHighlights: string[][] = [
  ["EHESS", "qualitative research projects end to end"],
  ["understanding what people genuinely need", "what people say", "their practices"],
  ["evidence-based interpretation", "insights that matter most", "practical recommendations"],
];
const splitIntro = (text: string, index: number) => {
  const terms = introHighlights[index] ?? [];
  const segments: { text: string; highlighted: boolean }[] = [];
  let position = 0;
  while (position < text.length) {
    let next: { term: string; index: number } | undefined;
    for (const term of terms) {
      const matchAt = text.indexOf(term, position);
      if (matchAt >= 0 && (!next || matchAt < next.index)) next = { term, index: matchAt };
    }
    if (!next) {
      segments.push({ text: text.slice(position), highlighted: false });
      break;
    }
    if (next.index > position) segments.push({ text: text.slice(position, next.index), highlighted: false });
    segments.push({ text: next.term, highlighted: true });
    position = next.index + next.term.length;
  }
  return segments;
};

---

<BaseLayout
  title={`${p.firstName} ${p.lastName} · ${p.role}`}
  description={`${p.firstName} ${p.lastName}, senior qualitative research consultant in Paris. Sociology, interviews, focus groups, ethnography and strategic recommendations.`}
  structuredData
>
  <Header />

  <main id="contenu">
    <!-- ═══ HERO : grand bloc arrondi, en retrait des bords ══════════════ -->
    <section class="px-3 pt-[7.5rem] pb-5 sm:px-6 sm:pt-[10rem] sm:pb-8">
      <div class="relative isolate h-[calc(100svh-8.75rem)] min-h-[42rem] overflow-hidden rounded-[2.5rem] sm:h-[calc(100svh-12rem)] sm:min-h-[36rem] sm:rounded-[5rem]">
        <Shot name="hero-fond" tone="dusk" class="absolute inset-0 -z-10" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(20_20_19/.82)_0%,rgb(20_20_19/.35)_55%,transparent_100%)]"></div>

        <!-- Portrait: standalone layer, anchored to the bottom/right of the frame. -->
        {portrait && (
          <div class="pointer-events-none absolute bottom-0 right-[-14%] z-0 h-[84%] w-[112%] sm:right-[2%] sm:h-[86%] sm:w-[min(46vw,40rem)] lg:right-[3%] lg:h-[96%] lg:w-[min(40vw,44rem)]">
            <div aria-hidden="true" class="absolute right-[-4%] top-[8%] z-0 aspect-square w-[min(86vw,30rem)] rounded-full border border-ember/65 sm:w-[min(44vw,36rem)] lg:left-1/2 lg:right-auto lg:top-1/2 lg:w-[min(38vw,40rem,76svh)] lg:-translate-x-1/2 lg:-translate-y-1/2"></div>
            <Image
              src={portrait}
              alt={`${p.firstName} ${p.lastName}`}
              widths={[480, 768, 1024, 1500]}
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 46vw, 112vw"
              class="absolute inset-0 z-10 h-full w-full object-contain object-bottom lg:origin-top lg:scale-[1.15]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}

        <div class="absolute inset-0 z-10 bg-[linear-gradient(90deg,rgb(20_20_19/.94)_0%,rgb(20_20_19/.82)_49%,rgb(20_20_19/.12)_100%)] lg:bg-none"></div>

        <!-- Mobile identity: top left. -->
        <div class="absolute left-6 right-6 top-6 z-40 lg:hidden">
          <p class="mb-2 text-[1.4175rem] font-medium tracking-[-0.04em] text-cream sm:text-[1.35rem]" data-reveal>{p.firstName} {p.lastName}</p>
          <p class="kicker max-w-[75%] text-[0.65rem] leading-snug" data-reveal>{p.role} · {p.city}</p>
        </div>

        <!-- Desktop identity: always visible at the top left. -->
        <div class="absolute left-10 top-8 z-40 hidden max-w-[40%] text-left lg:block lg:left-14 lg:top-10">
          <p class="mb-2 text-[clamp(1.35rem,2.3vw,2rem)] font-medium tracking-[-0.04em] text-cream" data-reveal>{p.firstName} <span class="lg:uppercase">{p.lastName}</span></p>
          <p class="kicker leading-snug" data-reveal>{p.role} · {p.city}</p>
        </div>

        <!-- Copy: anchored low to preserve clear space below the identity. -->
        <div class="absolute inset-x-0 bottom-0 z-30 flex flex-col items-start px-4 pb-8 text-left sm:px-16 sm:pb-10 lg:pl-[5.5rem] lg:pr-[46%] lg:pb-12">
          <h1 class="mt-0 w-full max-w-[19ch] text-[clamp(2.1rem,8.4vw,2.7825rem)] leading-[1.1] sm:mt-6 sm:max-w-[17ch] sm:text-[clamp(2.9rem,6.4vw,6.2rem)] lg:max-w-[16ch] lg:text-[clamp(2.6rem,3.8vw,4.2rem)] lg:leading-[1.12]" data-reveal>Understanding what <span class="underline decoration-ember decoration-[3px] underline-offset-[0.12em]">really</span> matters to people.</h1>
          <p class="mt-5 w-full max-w-[34rem] text-sm leading-[1.75] text-cream/85 sm:mt-7 sm:text-lg sm:leading-[1.7] lg:mt-5 lg:max-w-[30rem] lg:text-lg lg:leading-[1.65]" data-reveal>{site.pitch}</p>
          <div class="mt-7 flex flex-wrap gap-3 sm:mt-8 sm:gap-3 lg:mt-6 lg:gap-2.5" data-reveal>
            <a href="#contact" class="pill-line">Get in touch</a>
            <a href={withBase("/cv.pdf")} target="_blank" rel="noopener" class="pill-solid">My CV <span aria-hidden="true">↗</span></a>
            <a href={p.linkedin} target="_blank" rel="noopener noreferrer" class="pill-line">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PROFIL : titre à gauche, texte à droite ══════════════════════ -->
    <section id="profil" class="wrap scroll-mt-32 py-28 sm:py-36">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Sociologist by training, researcher by practice</h2>
        </div>
        <div class="space-y-5 text-[1.2rem] text-soft lg:col-span-5 lg:pt-3" data-reveal>
          {site.intro.map((t, i) => (
            <p>{splitIntro(t, i).map(({ text, highlighted }) => highlighted ? <span class="box-decoration-clone rounded-[0.35em] bg-ember px-[0.22em] py-[0.04em] font-medium text-[#141413]">{text}</span> : text)}</p>
          ))}
        </div>
      </div>

      <dl class="mt-24 grid gap-4 sm:grid-cols-3">
        {site.figures.map((f) => (
          <div class="rounded-[2.5rem] bg-coal px-9 py-10" data-reveal>
            <dt class="kicker">{f.label}</dt>
            <dd class="mt-6 text-[clamp(4rem,7vw,6.5rem)] font-medium leading-none tracking-[-0.04em] text-cream">
              <span data-count={f.value}>{f.value}</span><span class="text-ember">{f.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Research portfolio: no fictional case studies -->
    <!-- ═══ STUDIES: orbital carousel ═════════════════════════════════════ -->
    <section id="etudes" class="scroll-mt-28 pb-40 sm:pb-48">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker" data-reveal>Research</p>
          <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Understanding needs beyond what people say</h2>
        </div>
        <p class="text-[1.2rem] text-soft lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>Examples of completed projects and the challenges they explored.</p>
      </div>

      <div class="relative mt-16 h-[min(150vw,46rem)] sm:h-[min(56vw,46rem)]" data-carousel>

        <div class="wrap relative h-full">
          <div class="absolute right-4 top-0 z-20 flex gap-3 sm:right-10 lg:right-[6.5rem]">
            <button type="button" class="round" data-prev aria-label="Previous study">←</button>
            <button type="button" class="round" data-next aria-label="Next study">→</button>
          </div>

          <div class="orbit left-[30%] top-[6%] aspect-square w-[min(66vw,40rem)] sm:left-[38%] sm:top-0 sm:w-[min(46vw,40rem)]" aria-hidden="true"></div>

          <div class="absolute left-4 top-[6%] aspect-square w-[min(74vw,38rem)] sm:left-[6%] sm:top-0 sm:w-[min(44vw,38rem)]">
            {site.studyCarousel.map((s, i) => (
              <Shot name={s.photo} tone={s.tone} alt={s.topic} logo={i === 0 ? logoAmf : i === 3 ? photo('logo-arcom.png') : undefined} logoAlt={i === 0 ? 'Logo de l’Autorité des marchés financiers' : i === 3 ? 'Logo de l’Arcom' : undefined} aria-hidden={i === 0 ? "false" : "true"} class={`slide-img absolute inset-0 rounded-full ${i === 0 ? 'is-active' : ''}`} />
            ))}
          </div>

          <div class="absolute bottom-0 left-4 right-4 sm:bottom-auto sm:left-[56%] sm:right-10 sm:top-[24%] lg:right-[6.5rem]">
            {site.studyCarousel.map((s, i) => (
              <article class={`slide-txt ${i === 0 ? 'is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                <p class="kicker">{s.category}</p>
                <h3 class="mt-5 text-[clamp(1.8rem,2.8vw,2.7rem)]">{s.topic}</h3>
                <p class="mt-5 text-soft">{s.method}</p>
                <p class="mt-1 text-mute">→ {s.focus}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="absolute inset-x-0 -bottom-20 flex items-center justify-center gap-8">
          <div class="flex items-center gap-2.5">
            {site.studyCarousel.map((_, i) => (
              <button type="button" data-dot={i} aria-label={`Show research area ${i + 1}`} class={`dot ${i === 0 ? 'is-active' : ''}`}></button>
            ))}
          </div>
          <button type="button" class="round !size-10 text-xs" data-play aria-label="Pause">❚❚</button>
        </div>
      </div>
    </section>

    <!-- ═══ METHOD: connected circles ═════════════════════════════════════ -->
    <section id="methode" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Approach</p>
      <h2 class="mt-6 max-w-[18ch] text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>From research brief to boardroom recommendations</h2>

      <ol class="relative mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
        <span aria-hidden="true" class="absolute left-[10%] right-[10%] top-[5.5rem] hidden h-px bg-ember/70 lg:block"></span>
        {site.method.map((m, i) => (
          <li class="group relative" data-reveal>
            <div class="relative mx-auto grid aspect-square w-44 place-items-center rounded-full border border-cream/25 bg-night transition-colors duration-300 group-hover:border-ember group-hover:bg-ember">
              <span class="text-[3.2rem] font-medium tracking-[-0.04em] text-cream transition-colors group-hover:text-night">0{i + 1}</span>
            </div>
            <h3 class="mt-8 text-center text-[1.6rem]">{m.label}</h3>
            <p class="mx-auto mt-3 max-w-[16rem] text-center text-[1.02rem] text-soft">{m.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- STUDY TYPES -->
    <section class="wrap pb-20 sm:pb-28">
      <p class="kicker" data-reveal>Types of research</p>
      <ul class="mt-7 flex flex-wrap gap-3">
        {[
          'Exploratory research',
          'Understanding users and needs',
          'Concept and offer testing',
          'Communication testing',
          'UX testing · interfaces and journeys',
          'Customer journeys and experience',
          'Brand image and positioning',
          'Exploring customer satisfaction',
        ].map((type, i) => {
          const icons = ['⌕', '◉', '⌂', '▤', '◎', '⇄', '↗', '＋'];
          return <li class="inline-flex items-center gap-3 rounded-full border border-cream/20 bg-coal px-5 py-3 text-cream"><span class="grid size-7 place-items-center rounded-full bg-ember/15 text-ember" aria-hidden="true">{icons[i % icons.length]}</span>{type}</li>;
        })}
      </ul>
    </section>

    <!-- EXPERTISE -->
    <section class="wrap pb-20 sm:pb-28">
      <p class="kicker" data-reveal>Expertise</p>
      <div class="mt-7 grid gap-8 lg:grid-cols-3">
        {site.skillGroups.map((group) => (
          <div data-reveal>
            <h3 class="text-[1.35rem]">{group.title}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((skill) => <li class="rounded-full border border-cream/20 bg-coal px-4 py-2 text-[0.98rem] text-cream">{skill}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

        <!-- ═══ OUTILS & LANGUES : pilules ═══════════════════════════════════ -->
    <section class="wrap pb-28 sm:pb-36">
      <div class="grid gap-4 lg:grid-cols-3">
        {boxes.map((b) => (
          <div class="rounded-[2.5rem] bg-coal p-9" data-reveal>
            <p class="kicker">{b.title}</p>
            <ul class="mt-7 flex flex-wrap gap-2">
              {b.title === 'Research & analysis tools' ? (
                <>
                  <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{b.items[0]}</li>
                  <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{b.items[1]}</li>
                  <li class="basis-full h-0" aria-hidden="true"></li>
                  <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{b.items[2]}</li>
                  <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{b.items[3]}</li>
                </>
              ) : b.items.map((t) => <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ EXPERIENCE & EDUCATION ═════════════════════════════════════ -->
    <section id="parcours" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Background</p>
      <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>A path from research to practice</h2>
      <div class="mt-14">
        <h3 class="text-[1.6rem]" data-reveal>Professional experience</h3>
        <ol class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {site.experience.map((s, i) => (
            <li class={`flex flex-col rounded-[2.5rem] bg-coal p-4 pb-8 transition-colors hover:bg-tile ${i === 0 ? 'lg:col-span-2' : ''}`} data-reveal>
              <div class="flex flex-1 flex-col px-4 pt-7">
                <div class="mb-6 flex h-28 items-center justify-start gap-6" aria-label={i === 0 ? "CSA et Havas" : "Kantar"}>
                  {i === 0 ? (
                    <>
                      {logos.csa && <Image src={logos.csa} alt="CSA" class="h-28 w-28 object-contain" />}
                      {logos.havas && <Image src={logos.havas} alt="Havas" class="h-20 w-auto max-w-[16rem] translate-y-2 object-contain" />}
                    </>
                  ) : (
                    logos.kantar && <Image src={logos.kantar} alt="Kantar" class="h-14 w-auto max-w-[12rem] object-contain brightness-0 invert" />
                  )}
                </div>
                <p class="kicker">{s.when} · {s.where}</p>
                <h4 class="mt-4 text-[1.75rem]">{s.what}</h4>
                <p class="mt-3 text-soft">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-16">
        <h3 class="text-[1.6rem]" data-reveal>Education</h3>
        <ol class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {site.education.map((s, i) => (
            <li class="flex flex-col rounded-[2.5rem] bg-coal p-4 pb-8 transition-colors hover:bg-tile" data-reveal>
              <div class="flex flex-1 flex-col px-4 pt-7">
                <div class="mb-6 flex h-20 items-center justify-start px-4">
                  {i === 0 && logos.ehess && <Image src={logos.ehess} alt="EHESS" class="h-16 w-auto max-w-[14rem] object-contain" />}
                  {i === 1 && logos.berlin && <Image src={logos.berlin} alt="Technische Universität Berlin" class="h-16 w-auto max-w-[14rem] object-contain" />}
                  {i === 2 && logos.strasbourg && <Image src={logos.strasbourg} alt="Université de Strasbourg" class="h-16 w-auto max-w-[14rem] object-contain" />}
                </div>
                <p class="kicker">{s.when} · {s.where}</p>
                <h4 class="mt-4 text-[1.75rem]">{s.what}</h4>
                {'thesisTitle' in s && s.thesisTitle && <p class="mt-3 text-sm leading-relaxed text-paper">{s.thesisTitle}</p>}
                <p class="mt-3 text-soft">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>



    <!-- ═══ CONTACT : bloc orange ════════════════════════════════════════ -->
    <section id="contact" class="px-3 pb-3 sm:px-6 sm:pb-6">
      <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-ember px-6 py-24 text-night sm:rounded-[5rem] sm:px-16 sm:py-32 lg:px-[5.5rem]">
        <div class="pointer-events-none absolute -right-[10vw] -top-[20%] -z-10 aspect-square w-[50vw] rounded-full border border-night/30" data-speed="0.2" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-[-30%] right-[12vw] -z-10 aspect-square w-[24vw] rounded-full bg-night/10" data-speed="0.45" aria-hidden="true"></div>
        <p class="inline-flex items-center gap-3 text-[0.82rem] font-semibold uppercase tracking-[0.04em]"><span class="size-2.5 rounded-full bg-night"></span>Contact</p>
        <h2 class="mt-6 max-w-[14ch] text-[clamp(2.8rem,6.4vw,6.2rem)] !text-night">Let’s discuss your next research project</h2>
        <p class="mt-6 max-w-lg text-lg text-night/80">Have a question to explore, user needs to understand or a phenomenon to investigate? Research in French or English. Based in Paris.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${p.email}`} class="pill bg-night text-cream hover:bg-coal">Send an email <span aria-hidden="true">↗</span></a>
          <button type="button" data-copy-email class="pill border border-night/40 text-night hover:bg-night/10" aria-label="Copy email address">
            <span class="break-all">{p.email}</span> <span aria-hidden="true">⧉</span>
          </button>
        </div>
        <p class="mt-3 text-sm text-night/75" data-copy-feedback aria-live="polite"></p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // ── Research carousel ───────────────────────────────────────────────
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const images = carousel.querySelectorAll<HTMLElement>('.slide-img');
    const texts = carousel.querySelectorAll<HTMLElement>('.slide-txt');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('[data-dot]');
    const play = carousel.querySelector<HTMLButtonElement>('[data-play]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer = 0;
    let playing = !reduceMotion;

    const show = (index: number) => {
      active = (index + images.length) % images.length;
      images.forEach((element, i) => {
        element.classList.toggle('is-active', i === active);
        element.setAttribute('aria-hidden', String(i !== active));
      });
      texts.forEach((element, i) => {
        element.classList.toggle('is-active', i === active);
        element.setAttribute('aria-hidden', String(i !== active));
      });
      dots.forEach((element, i) => {
        element.classList.toggle('is-active', i === active);
        element.setAttribute('aria-current', i === active ? 'true' : 'false');
      });
    };
    const armTimer = () => {
      window.clearInterval(timer);
      if (playing && images.length > 1) timer = window.setInterval(() => show(active + 1), 6000);
    };
    const setPlaying = (value: boolean) => {
      playing = value;
      if (play) {
        play.textContent = value ? '❚❚' : '▶';
        play.setAttribute('aria-label', value ? 'Pause' : 'Resume slideshow');
      }
      armTimer();
    };

    previous?.addEventListener('click', () => { show(active - 1); armTimer(); });
    next?.addEventListener('click', () => { show(active + 1); armTimer(); });
    dots.forEach((dot) => dot.addEventListener('click', () => { show(Number(dot.dataset.dot)); armTimer(); }));
    play?.addEventListener('click', () => setPlaying(!playing));
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', armTimer);
    carousel.addEventListener('focusin', () => window.clearInterval(timer));
    carousel.addEventListener('focusout', armTimer);
    setPlaying(playing);
  }

  // ── Copy email address ─────────────────────────────────────────
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  if (copyEmailButton && copyFeedback) {
    copyEmailButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText("augustin.vinotmarull@gmail.com");
        copyFeedback.textContent = 'Email address copied.';
      } catch {
        copyFeedback.textContent = 'Automatic copy failed. You can still use the email link.';
      }
    });
  }

  // ── Compteurs ───────────────────────────────────────────────────────
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const animateCounter = (el: HTMLElement) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = Number(el.dataset.count);
      const duration = 1600;
      const start = performance.now();
      el.textContent = '0';
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(end * eased));
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = String(end);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.25, rootMargin: '0px 0px -5% 0px' });
      counters.forEach((counter) => counterObserver.observe(counter));
    } else {
      counters.forEach(animateCounter);
    }
  }
</script>
