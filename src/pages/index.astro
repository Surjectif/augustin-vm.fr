---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Shot from '@/components/Shot.astro';
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import { photo } from '@/lib/photos';

const p = site.person;
type Tone = 'moss' | 'ember' | 'stone' | 'dusk';
const toneOf: Record<string, Tone> = {
  énergie: 'ember', territoire: 'dusk', consommation: 'stone',
  assurance: 'stone', mobilité: 'dusk', biodiversité: 'moss',
};
const studies = site.studies.map((s) => ({ ...s, tone: toneOf[s.tag] ?? 'stone' }));
const pathTones: Tone[] = ['ember', 'stone', 'dusk', 'moss', 'stone'];
const portrait = photo('portrait');
const boxes = [
  { title: 'Analyse & traitement', items: [...site.analysisTools] as string[] },
  { title: 'Création visuelle', items: [...site.creativeTools] as string[] },
  { title: 'Langues', items: site.languages.map((l) => `${l.name} · ${l.level}`) },
];
---

<BaseLayout
  title={`${p.firstName} ${p.lastName} · ${p.role}`}
  description={`${p.firstName} ${p.lastName}, chargé d’études qualitatives à Paris. Sociologue (EHESS), passé par Kantar et CSA / Havas : entretiens, focus groups, ethnographie, recommandations.`}
  structuredData
>
  <Header />

  <main id="contenu">
    <!-- ═══ HERO : grand bloc arrondi, en retrait des bords ══════════════ -->
    <section class="px-3 pt-[7.5rem] pb-5 sm:px-6 sm:pt-[10rem] sm:pb-8">
      <div class="relative isolate h-[calc(100svh-8.75rem)] min-h-[36rem] overflow-hidden rounded-[2.5rem] sm:h-[calc(100svh-12rem)] sm:rounded-[5rem]">
        <Shot name="hero-fond" tone="dusk" class="absolute inset-0 -z-10" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(20_20_19/.82)_0%,rgb(20_20_19/.35)_55%,transparent_100%)]"></div>
        <div class="orbit -right-[18vw] -top-[30vh] aspect-square w-[70vw] opacity-60" data-speed="-0.15" aria-hidden="true"></div>

        {portrait && (
          <div class="absolute bottom-0 right-[6%] hidden h-[82%] w-[min(30vw,30rem)] overflow-hidden rounded-t-full bg-white lg:block">
            <Image src={portrait} alt={`${p.firstName} ${p.lastName}`} widths={[480, 800, 1100]} sizes="30vw" class="absolute inset-x-0 bottom-0 h-[112%] w-full object-cover object-top" loading="eager" fetchpriority="high" />
          </div>
        )}

        <div class="absolute inset-x-0 bottom-0 px-6 pb-14 sm:px-16 sm:pb-20 lg:pl-[5.5rem] lg:pr-[40%]">
          <p class="kicker" data-reveal>{p.role} · {p.city}</p>
          <h1 class="mt-6 max-w-[15ch] text-[clamp(2.9rem,6.4vw,6.2rem)] lg:text-[clamp(3rem,4.7vw,5rem)]" data-reveal>Comprendre ce qui compte <span class="underline decoration-ember decoration-[3px] underline-offset-[0.12em]">vraiment</span> pour les gens.</h1>
          <p class="mt-6 max-w-[36rem] text-lg text-cream/85 sm:text-xl" data-reveal>{site.pitch}</p>
          <div class="mt-10 flex flex-wrap gap-3" data-reveal>
            <a href="#etudes" class="pill-solid">Voir les études <span aria-hidden="true">→</span></a>
            <a href="#contact" class="pill-line">Me contacter</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PROFIL : titre à gauche, texte à droite ══════════════════════ -->
    <section id="profil" class="wrap scroll-mt-32 py-28 sm:py-36">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Sociologue de formation, enquêteur de métier</h2>
          {portrait && (
            <div class="relative mt-10 aspect-[3/4] w-[min(80vw,22rem)] overflow-hidden rounded-t-full bg-white lg:hidden" data-reveal>
              <Image src={portrait} alt={`${p.firstName} ${p.lastName}`} widths={[400, 700]} sizes="80vw" class="absolute inset-x-0 bottom-0 h-[115%] w-full object-cover object-top" />
            </div>
          )}
        </div>
        <div class="space-y-5 text-[1.2rem] text-soft lg:col-span-5 lg:pt-3" data-reveal>
          {site.intro.map((t) => <p>{t}</p>)}
        </div>
      </div>

      <dl class="mt-24 grid gap-4 sm:grid-cols-3">
        {site.figures.map((f) => (
          <div class="rounded-[2.5rem] bg-coal px-9 py-10" data-reveal>
            <dt class="kicker">{f.label}</dt>
            <dd class="mt-6 text-[clamp(4rem,7vw,6.5rem)] font-medium leading-none tracking-[-0.04em] text-cream">
              <span data-count={f.value}>{f.value}</span><span class="text-ember">{f.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ═══ ÉTUDES : carrousel en orbite ═════════════════════════════════ -->
    <section id="etudes" class="scroll-mt-28 pb-40 sm:pb-48">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker" data-reveal>Historique</p>
          <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Comprendre les besoins au-delà des déclarations</h2>
        </div>
        <p class="text-[1.2rem] lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>Partir des usages, des contraintes et des arbitrages pour comprendre ce qui compte réellement pour les personnes. Quelques terrains d’étude, présentés dans le respect de la confidentialité.</p>
      </div>

      <div class="relative mt-16 h-[min(150vw,46rem)] sm:h-[min(56vw,46rem)]" data-carousel>
        <!-- cercles latéraux, à moitié hors écran, en parallaxe -->
        <Shot name="deco-foret" tone="moss" class="absolute -left-[12vw] top-[4%] hidden aspect-square w-[22vw] rounded-full sm:block" data-speed="0.12" />
        <Shot name="deco-champ" tone="stone" class="absolute -right-[10vw] top-[38%] hidden aspect-square w-[18vw] rounded-full sm:block" data-speed="0.25" />

        <div class="wrap relative h-full">
          <div class="absolute right-4 top-0 z-20 flex gap-3 sm:right-10 lg:right-[6.5rem]">
            <button type="button" class="round" data-prev aria-label="Étude précédente">←</button>
            <button type="button" class="round" data-next aria-label="Étude suivante">→</button>
          </div>

          <!-- orbite -->
          <div class="orbit left-[30%] top-[6%] aspect-square w-[min(66vw,40rem)] sm:left-[38%] sm:top-0 sm:w-[min(46vw,40rem)]" aria-hidden="true"></div>

          <!-- grand cercle : une image par étude -->
          <div class="absolute left-4 top-[6%] aspect-square w-[min(74vw,38rem)] sm:left-[6%] sm:top-0 sm:w-[min(44vw,38rem)]">
            {studies.map((s, i) => (
              <Shot name={s.photo} tone={s.tone} label={`photo · ${s.tag}`} alt={s.theme} class={`slide-img absolute inset-0 rounded-full ${i === 0 ? 'is-active' : ''}`} />
            ))}
          </div>

          <!-- texte de l'étude, dans l'orbite -->
          <div class="absolute bottom-0 left-4 right-4 sm:bottom-auto sm:left-[56%] sm:right-10 sm:top-[24%] lg:right-[6.5rem]">
            {studies.map((s, i) => (
              <article class={`slide-txt ${i === 0 ? 'is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                <p class="kicker">{s.year} · {s.org}</p>
                <h3 class="mt-5 text-[clamp(1.8rem,2.8vw,2.7rem)]">{s.theme}</h3>
                <p class="mt-5 text-soft">{s.method}</p>
                <p class="mt-1 text-mute">→ {s.deliverable}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="absolute inset-x-0 -bottom-20 flex items-center justify-center gap-8">
          <div class="flex items-center gap-2.5">
            {studies.map((_, i) => (
              <button type="button" data-dot={i} aria-label={`Étude ${i + 1}`} class={`dot ${i === 0 ? 'is-active' : ''}`}></button>
            ))}
          </div>
          <button type="button" class="round !size-10 text-xs" data-play aria-label="Mettre en pause">❚❚</button>
        </div>
      </div>
    </section>

    <!-- ═══ MÉTHODE : cercles reliés ═════════════════════════════════════ -->
    <section id="methode" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Méthode</p>
      <h2 class="mt-6 max-w-[18ch] text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Du cahier des charges au comité de direction</h2>

      <ol class="relative mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
        <span aria-hidden="true" class="absolute left-[10%] right-[10%] top-[5.5rem] hidden h-px bg-ember/70 lg:block"></span>
        {site.method.map((m, i) => (
          <li class="group relative" data-reveal>
            <div class="relative mx-auto grid aspect-square w-44 place-items-center rounded-full border border-cream/25 bg-night transition-colors duration-300 group-hover:border-ember group-hover:bg-ember">
              <span class="text-[3.2rem] font-medium tracking-[-0.04em] text-cream transition-colors group-hover:text-night">0{i + 1}</span>
            </div>
            <h3 class="mt-8 text-center text-[1.6rem]">{m.label}</h3>
            <p class="mx-auto mt-3 max-w-[16rem] text-center text-[1.02rem] text-soft">{m.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- SAVOIR-FAIRE -->
    <section class="wrap pb-20 sm:pb-28">
      <p class="kicker" data-reveal>Savoir-faire</p>
      <ul class="mt-7 flex flex-wrap gap-3">
        {site.skills.map((skill, i) => {
          const icons = ['⌕', '◉', '⌂', '▤', '◎', '⇄', '↗'];
          return <li class="inline-flex items-center gap-3 rounded-full border border-cream/20 bg-coal px-5 py-3 text-cream"><span class="grid size-7 place-items-center rounded-full bg-ember/15 text-ember" aria-hidden="true">{icons[i % icons.length]}</span>{skill}</li>;
        })}
      </ul>
    </section>

    <!-- ═══ OUTILS & LANGUES : pilules ═══════════════════════════════════ -->
    <section class="wrap pb-28 sm:pb-36">
      <div class="grid gap-4 lg:grid-cols-3">
        {boxes.map((b) => (
          <div class="rounded-[2.5rem] bg-coal p-9" data-reveal>
            <p class="kicker">{b.title}</p>
            <ul class="mt-7 flex flex-wrap gap-2">
              {b.items.map((t) => <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ PARCOURS : tuiles arrondies ══════════════════════════════════ -->
    <section id="parcours" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Parcours</p>
      <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Strasbourg, Berlin, Paris</h2>

      <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {site.path.map((s, i) => (
          <li class={`flex flex-col rounded-[2.5rem] bg-coal p-4 pb-8 transition-colors hover:bg-tile ${i === 0 ? 'lg:col-span-2' : ''}`} data-reveal>
            <Shot name={s.photo} tone={pathTones[i]} alt={s.where} class="h-44 rounded-full" />
            <div class="flex flex-1 flex-col px-4 pt-7">
              <p class="kicker">{s.when} · {s.where}</p>
              <h3 class="mt-4 text-[1.75rem]">{s.what}</h3>
              <p class="mt-3 text-soft">{s.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ═══ CONTACT : bloc orange ════════════════════════════════════════ -->
    <section id="contact" class="px-3 pb-3 sm:px-6 sm:pb-6">
      <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-ember px-6 py-24 text-night sm:rounded-[5rem] sm:px-16 sm:py-32 lg:px-[5.5rem]">
        <div class="pointer-events-none absolute -right-[10vw] -top-[20%] -z-10 aspect-square w-[50vw] rounded-full border border-night/30" data-speed="0.2" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-[-30%] right-[12vw] -z-10 aspect-square w-[24vw] rounded-full bg-night/10" data-speed="0.45" aria-hidden="true"></div>
        <p class="inline-flex items-center gap-3 text-[0.82rem] font-semibold uppercase tracking-[0.04em]"><span class="size-2.5 rounded-full bg-night"></span>Contact</p>
        <h2 class="mt-6 max-w-[14ch] text-[clamp(2.8rem,6.4vw,6.2rem)] !text-night">Parlons de votre prochaine étude</h2>
        <p class="mt-6 max-w-lg text-lg text-night/80">Vous avez une problématique à éclairer, des usages à comprendre ou un phénomène à décrypter ? Études en français ou en anglais. Basé à Paris.</p>
        <button type="button" data-copy-email class="pill mt-10 bg-night text-cream hover:bg-coal" aria-label="Copier l’adresse e-mail">
          <span class="break-all">{p.email}</span> <span aria-hidden="true">⧉</span>
        </button>
        <p class="mt-3 text-sm text-night/75" data-copy-feedback aria-live="polite"></p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* carrousel */
  .slide-img { opacity: 0; transform: scale(.92); transition: opacity .8s ease, transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .slide-img.is-active { opacity: 1; transform: none; }
  .slide-txt { position: absolute; inset: 0 0 auto 0; opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .8s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .slide-txt.is-active { position: relative; opacity: 1; transform: none; pointer-events: auto; transition-delay: .15s; }

  .dot { width: .5rem; height: .5rem; border-radius: 999px; background: var(--color-cream); transition: width .4s ease, background .3s; }
  .dot.is-active { width: 2.5rem; background: var(--color-ember); }

  @media (prefers-reduced-motion: reduce) {
    .slide-img, .slide-txt, .dot { transition: none; }
  }
</style>

<script>
  // ── Carrousel des études ────────────────────────────────────────────
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const imgs = root.querySelectorAll<HTMLElement>('.slide-img');
    const txts = root.querySelectorAll<HTMLElement>('.slide-txt');
    const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer = 0, playing = !reduce;

    const go = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((el, k) => el.classList.toggle('is-active', k === i));
      txts.forEach((el, k) => { el.classList.toggle('is-active', k === i); el.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((el, k) => el.classList.toggle('is-active', k === i));
    };
    const arm = () => { clearInterval(timer); if (playing) timer = window.setInterval(() => go(i + 1), 6000); };
    const setPlay = (v: boolean) => {
      playing = v;
      play.textContent = v ? '❚❚' : '▶';
      play.setAttribute('aria-label', v ? 'Mettre en pause' : 'Lecture');
      arm();
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => { go(i - 1); arm(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { go(i + 1); arm(); });
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.dot)); arm(); }));
    play.addEventListener('click', () => setPlay(!playing));
    setPlay(playing);
  }

  // ── Copier l'adresse e-mail ─────────────────────────────────────────
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  if (copyEmailButton && copyFeedback) {
    copyEmailButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText("augustin.vinotmarull@gmail.com");
        copyFeedback.textContent = 'Adresse e-mail copiée.';
      } catch {
        copyFeedback.textContent = 'La copie automatique a échoué. Sélectionnez l’adresse pour la copier.';
      }
    });
  }

  // ── Compteurs ───────────────────────────────────────────────────────
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const animateCounter = (el: HTMLElement) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = Number(el.dataset.count);
      const duration = 1600;
      const start = performance.now();
      el.textContent = '0';
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(end * eased));
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = String(end);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.25, rootMargin: '0px 0px -5% 0px' });
      counters.forEach((counter) => counterObserver.observe(counter));
    } else {
      counters.forEach(animateCounter);
    }
  }
</script>
