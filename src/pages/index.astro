---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Shot from '@/components/Shot.astro';
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import { photo } from '@/lib/photos';

const p = site.person;
const portrait = photo('portrait-transparent-2');
const boxes = [
  { title: 'Outils d’analyse', items: [...site.analysisTools] as string[] },
  { title: 'Pratique créative complémentaire', items: [...site.creativeTools] as string[] },
  { title: 'Langues', items: site.languages.map((l) => `${l.name} · ${l.level}`) },
];
---

<BaseLayout
  title={`${p.firstName} ${p.lastName} · ${p.role}`}
  description={`${p.firstName} ${p.lastName}, chargé d’études qualitatives à Paris. Sociologue (EHESS), passé par Kantar et CSA / Havas : entretiens, focus groups, ethnographie, recommandations.`}
  structuredData
>
  <Header />

  <main id="contenu">
    <!-- ═══ HERO : grand bloc arrondi, en retrait des bords ══════════════ -->
    <section class="px-3 pt-[7.5rem] pb-5 sm:px-6 sm:pt-[10rem] sm:pb-8">
      <div class="relative isolate h-[calc(100svh-8.75rem)] min-h-[36rem] overflow-hidden rounded-[2.5rem] sm:h-[calc(100svh-12rem)] sm:rounded-[5rem]">
        <Shot name="hero-fond" tone="dusk" class="absolute inset-0 -z-10" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(20_20_19/.82)_0%,rgb(20_20_19/.35)_55%,transparent_100%)]"></div>
        {portrait && (
          <div class="absolute bottom-0 right-[3%] z-10 hidden h-[88%] w-[min(38vw,38rem)] overflow-hidden lg:block">
            <Image src={portrait} alt={`${p.firstName} ${p.lastName}`} widths={[600, 900, 1200, 1500]} sizes="38vw" class="absolute inset-x-0 top-0 h-[125%] w-full object-cover object-top" loading="eager" fetchpriority="high" />
          </div>
        )}

        <div class="absolute inset-x-0 bottom-0 z-20 px-6 pb-14 sm:px-16 sm:pb-20 lg:pl-[5.5rem] lg:pr-[40%]">
          <p class="kicker" data-reveal>{p.role} · {p.city}</p>
          <h1 class="mt-6 max-w-[15ch] text-[clamp(2.9rem,6.4vw,6.2rem)] lg:text-[clamp(3rem,4.7vw,5rem)]" data-reveal>Comprendre ce qui compte <span class="underline decoration-ember decoration-[3px] underline-offset-[0.12em]">vraiment</span> pour les gens.</h1>
          <p class="mt-6 max-w-[36rem] text-lg text-cream/85 sm:text-xl" data-reveal>{site.pitch}</p>
          <div class="mt-10 flex flex-wrap gap-3" data-reveal>
            <a href="#contact" class="pill-line">Me contacter</a>
            <a href="/cv.pdf" target="_blank" rel="noopener" class="pill-solid">Mon CV <span aria-hidden="true">↗</span></a>
            <a href={p.linkedin} target="_blank" rel="noopener noreferrer" class="pill-line">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PROFIL : titre à gauche, texte à droite ══════════════════════ -->
    <section id="profil" class="wrap scroll-mt-32 py-28 sm:py-36">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Sociologue de formation, enquêteur de métier</h2>
          {portrait && (
            <div class="relative mt-10 aspect-[3/4] w-[min(80vw,22rem)] lg:hidden" data-reveal>
              <Image src={portrait} alt={`${p.firstName} ${p.lastName}`} widths={[400, 700]} sizes="80vw" class="absolute inset-x-0 bottom-0 h-full w-full object-contain object-bottom" />
            </div>
          )}
        </div>
        <div class="space-y-5 text-[1.2rem] text-soft lg:col-span-5 lg:pt-3" data-reveal>
          {site.intro.map((t) => <p>{t}</p>)}
        </div>
      </div>

      <dl class="mt-24 grid gap-4 sm:grid-cols-3">
        {site.figures.map((f) => (
          <div class="rounded-[2.5rem] bg-coal px-9 py-10" data-reveal>
            <dt class="kicker">{f.label}</dt>
            <dd class="mt-6 text-[clamp(4rem,7vw,6.5rem)] font-medium leading-none tracking-[-0.04em] text-cream">
              <span data-count={f.value}>{f.value}</span><span class="text-ember">{f.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Portfolio d’études : aucun cas fictif publié -->
    <!-- ═══ ÉTUDES : carrousel en orbite ═════════════════════════════════ -->
    <section id="etudes" class="scroll-mt-28 pb-40 sm:pb-48">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker" data-reveal>Études</p>
          <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Comprendre les besoins au-delà des déclarations</h2>
        </div>
        <p class="text-[1.2rem] text-soft lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>Voici quelques questions que les études qualitatives peuvent aider à explorer.</p>
      </div>

      <div class="relative mt-16 h-[min(150vw,46rem)] sm:h-[min(56vw,46rem)]" data-carousel>
        <Shot name="deco-foret" tone="moss" class="absolute -left-[12vw] top-[4%] hidden aspect-square w-[22vw] rounded-full sm:block" data-speed="0.12" />
        <Shot name="deco-champ" tone="stone" class="absolute -right-[10vw] top-[38%] hidden aspect-square w-[18vw] rounded-full sm:block" data-speed="0.25" />

        <div class="wrap relative h-full">
          <div class="absolute right-4 top-0 z-20 flex gap-3 sm:right-10 lg:right-[6.5rem]">
            <button type="button" class="round" data-prev aria-label="Étude précédente">←</button>
            <button type="button" class="round" data-next aria-label="Étude suivante">→</button>
          </div>

          <div class="orbit left-[30%] top-[6%] aspect-square w-[min(66vw,40rem)] sm:left-[38%] sm:top-0 sm:w-[min(46vw,40rem)]" aria-hidden="true"></div>

          <div class="absolute left-4 top-[6%] aspect-square w-[min(74vw,38rem)] sm:left-[6%] sm:top-0 sm:w-[min(44vw,38rem)]">
            {site.studyCarousel.map((s, i) => (
              <Shot name={s.photo} tone={s.tone} alt={s.topic} class={`slide-img absolute inset-0 rounded-full ${i === 0 ? 'is-active' : ''}`} />
            ))}
          </div>

          <div class="absolute bottom-0 left-4 right-4 sm:bottom-auto sm:left-[56%] sm:right-10 sm:top-[24%] lg:right-[6.5rem]">
            {site.studyCarousel.map((s, i) => (
              <article class={`slide-txt ${i === 0 ? 'is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                <p class="kicker">{s.category}</p>
                <h3 class="mt-5 text-[clamp(1.8rem,2.8vw,2.7rem)]">{s.topic}</h3>
                <p class="mt-5 text-soft">{s.method}</p>
                <p class="mt-1 text-mute">→ {s.focus}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="absolute inset-x-0 -bottom-20 flex items-center justify-center gap-8">
          <div class="flex items-center gap-2.5">
            {site.studyCarousel.map((_, i) => (
              <button type="button" data-dot={i} aria-label={`Afficher le champ d’étude ${i + 1}`} class={`dot ${i === 0 ? 'is-active' : ''}`}></button>
            ))}
          </div>
          <button type="button" class="round !size-10 text-xs" data-play aria-label="Mettre en pause">❚❚</button>
        </div>
      </div>
    </section>

    <!-- ═══ MÉTHODE : cercles reliés ═════════════════════════════════════ -->
    <section id="methode" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Méthode</p>
      <h2 class="mt-6 max-w-[18ch] text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Du cahier des charges au partage des résultats</h2>

      <ol class="relative mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
        <span aria-hidden="true" class="absolute left-[10%] right-[10%] top-[5.5rem] hidden h-px bg-ember/70 lg:block"></span>
        {site.method.map((m, i) => (
          <li class="group relative" data-reveal>
            <div class="relative mx-auto grid aspect-square w-44 place-items-center rounded-full border border-cream/25 bg-night transition-colors duration-300 group-hover:border-ember group-hover:bg-ember">
              <span class="text-[3.2rem] font-medium tracking-[-0.04em] text-cream transition-colors group-hover:text-night">0{i + 1}</span>
            </div>
            <h3 class="mt-8 text-center text-[1.6rem]">{m.label}</h3>
            <p class="mx-auto mt-3 max-w-[16rem] text-center text-[1.02rem] text-soft">{m.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- TYPES D'ÉTUDES -->
    <section class="wrap pb-20 sm:pb-28">
      <p class="kicker" data-reveal>Types d’études</p>
      <ul class="mt-7 flex flex-wrap gap-3">
        {[
          'Études exploratoires',
          'Compréhension des usages et des besoins',
          'Tests de concepts et d’offres',
          'Tests de communication',
          'Tests UX · interfaces et parcours',
          'Parcours et expérience client',
          'Image et positionnement',
          'Exploration de la satisfaction',
        ].map((type, i) => {
          const icons = ['⌕', '◉', '⌂', '▤', '◎', '⇄', '↗', '＋'];
          return <li class="inline-flex items-center gap-3 rounded-full border border-cream/20 bg-coal px-5 py-3 text-cream"><span class="grid size-7 place-items-center rounded-full bg-ember/15 text-ember" aria-hidden="true">{icons[i % icons.length]}</span>{type}</li>;
        })}
      </ul>
    </section>

    <!-- SAVOIR-FAIRE -->
    <section class="wrap pb-20 sm:pb-28">
      <p class="kicker" data-reveal>Savoir-faire</p>
      <div class="mt-7 grid gap-8 lg:grid-cols-3">
        {site.skillGroups.map((group) => (
          <div data-reveal>
            <h3 class="text-[1.35rem]">{group.title}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((skill) => <li class="rounded-full border border-cream/20 bg-coal px-4 py-2 text-[0.98rem] text-cream">{skill}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ OUTILS & LANGUES : pilules ═══════════════════════════════════ -->
    <section class="wrap pb-28 sm:pb-36">
      <div class="grid gap-4 lg:grid-cols-3">
        {boxes.map((b) => (
          <div class="rounded-[2.5rem] bg-coal p-9" data-reveal>
            <p class="kicker">{b.title}</p>
            <ul class="mt-7 flex flex-wrap gap-2">
              {b.items.map((t) => <li class="rounded-full border border-cream/20 px-4 py-2 text-[0.98rem] text-cream">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ PARCOURS : expérience et formation séparées ═════════════════ -->
    <section id="parcours" class="wrap scroll-mt-32 pb-28 sm:pb-36">
      <p class="kicker" data-reveal>Parcours</p>
      <h2 class="mt-6 text-[clamp(2.4rem,4.6vw,4.4rem)]" data-reveal>Un parcours entre recherche et terrain</h2>
      <div class="mt-14">
        <h3 class="text-[1.6rem]" data-reveal>Expérience professionnelle</h3>
        <ol class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {site.experience.map((s, i) => (
            <li class={`flex flex-col rounded-[2.5rem] bg-coal p-4 pb-8 transition-colors hover:bg-tile ${i === 0 ? 'lg:col-span-2' : ''}`} data-reveal>
              <div class="flex flex-1 flex-col px-4 pt-7">
                <p class="kicker">{s.when} · {s.where}</p>
                <h4 class="mt-4 text-[1.75rem]">{s.what}</h4>
                <p class="mt-3 text-soft">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-16">
        <h3 class="text-[1.6rem]" data-reveal>Formation</h3>
        <ol class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {site.education.map((s, i) => (
            <li class="flex flex-col rounded-[2.5rem] bg-coal p-4 pb-8 transition-colors hover:bg-tile" data-reveal>
              <div class="flex flex-1 flex-col px-4 pt-7">
                <p class="kicker">{s.when} · {s.where}</p>
                <h4 class="mt-4 text-[1.75rem]">{s.what}</h4>
                <p class="mt-3 text-soft">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ CONTACT : bloc orange ════════════════════════════════════════ -->
    <section id="contact" class="px-3 pb-3 sm:px-6 sm:pb-6">
      <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-ember px-6 py-24 text-night sm:rounded-[5rem] sm:px-16 sm:py-32 lg:px-[5.5rem]">
        <div class="pointer-events-none absolute -right-[10vw] -top-[20%] -z-10 aspect-square w-[50vw] rounded-full border border-night/30" data-speed="0.2" aria-hidden="true"></div>
        <div class="pointer-events-none absolute bottom-[-30%] right-[12vw] -z-10 aspect-square w-[24vw] rounded-full bg-night/10" data-speed="0.45" aria-hidden="true"></div>
        <p class="inline-flex items-center gap-3 text-[0.82rem] font-semibold uppercase tracking-[0.04em]"><span class="size-2.5 rounded-full bg-night"></span>Contact</p>
        <h2 class="mt-6 max-w-[14ch] text-[clamp(2.8rem,6.4vw,6.2rem)] !text-night">Parlons de votre prochaine étude</h2>
        <p class="mt-6 max-w-lg text-lg text-night/80">Vous avez une problématique à éclairer, des usages à comprendre ou un phénomène à décrypter ?<br />Études en français ou en anglais. Basé à Paris.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${p.email}`} class="pill bg-night text-cream hover:bg-coal">Envoyer un e-mail <span aria-hidden="true">↗</span></a>
          <button type="button" data-copy-email class="pill border border-night/40 text-night hover:bg-night/10" aria-label="Copier l’adresse e-mail">
            <span class="break-all">{p.email}</span> <span aria-hidden="true">⧉</span>
          </button>
        </div>
        <p class="mt-3 text-sm text-night/75" data-copy-feedback aria-live="polite"></p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // ── Carrousel des études ────────────────────────────────────────────
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const images = carousel.querySelectorAll<HTMLElement>('.slide-img');
    const texts = carousel.querySelectorAll<HTMLElement>('.slide-txt');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('[data-dot]');
    const play = carousel.querySelector<HTMLButtonElement>('[data-play]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer = 0;
    let playing = !reduceMotion;

    const show = (index: number) => {
      active = (index + images.length) % images.length;
      images.forEach((element, i) => element.classList.toggle('is-active', i === active));
      texts.forEach((element, i) => {
        element.classList.toggle('is-active', i === active);
        element.setAttribute('aria-hidden', String(i !== active));
      });
      dots.forEach((element, i) => {
        element.classList.toggle('is-active', i === active);
        element.setAttribute('aria-current', i === active ? 'true' : 'false');
      });
    };
    const armTimer = () => {
      window.clearInterval(timer);
      if (playing && images.length > 1) timer = window.setInterval(() => show(active + 1), 6000);
    };
    const setPlaying = (value: boolean) => {
      playing = value;
      if (play) {
        play.textContent = value ? '❚❚' : '▶';
        play.setAttribute('aria-label', value ? 'Mettre en pause' : 'Reprendre le défilement');
      }
      armTimer();
    };

    previous?.addEventListener('click', () => { show(active - 1); armTimer(); });
    next?.addEventListener('click', () => { show(active + 1); armTimer(); });
    dots.forEach((dot) => dot.addEventListener('click', () => { show(Number(dot.dataset.dot)); armTimer(); }));
    play?.addEventListener('click', () => setPlaying(!playing));
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', armTimer);
    carousel.addEventListener('focusin', () => window.clearInterval(timer));
    carousel.addEventListener('focusout', armTimer);
    setPlaying(playing);
  }

  // ── Copier l'adresse e-mail ─────────────────────────────────────────
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  if (copyEmailButton && copyFeedback) {
    copyEmailButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText("augustin.vinotmarull@gmail.com");
        copyFeedback.textContent = 'Adresse e-mail copiée.';
      } catch {
        copyFeedback.textContent = 'La copie automatique a échoué. Vous pouvez utiliser le lien e-mail.';
      }
    });
  }

  // ── Compteurs ───────────────────────────────────────────────────────
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const animateCounter = (el: HTMLElement) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = Number(el.dataset.count);
      const duration = 1600;
      const start = performance.now();
      el.textContent = '0';
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(end * eased));
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = String(end);
      };
      requestAnimationFrame(step);
    };
    if ('IntersectionObserver' in window) {
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.25, rootMargin: '0px 0px -5% 0px' });
      counters.forEach((counter) => counterObserver.observe(counter));
    } else {
      counters.forEach(animateCounter);
    }
  }
</script>
