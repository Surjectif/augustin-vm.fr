---
import '@/styles/global.css';
import { site } from '@/data/site';
import { withBase } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  structuredData?: boolean;
}

const { title, description, noindex = false, structuredData = false } = Astro.props;
const p = site.person;

// On garde le « / » final de l'accueil : c'est l'URL que sert GitHub Pages.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${p.firstName} ${p.lastName}`,
  givenName: p.firstName,
  jobTitle: p.role,
  url: new URL(withBase('/'), site.url).href,
  email: `mailto:${p.email}`,
  address: { '@type': 'PostalAddress', addressLocality: p.city, addressCountry: 'FR' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'EHESS' },
    { '@type': 'CollegeOrUniversity', name: 'Technische Universität Berlin' },
    { '@type': 'CollegeOrUniversity', name: 'Université de Strasbourg' },
  ],
  knowsAbout: [...site.skills],
  knowsLanguage: ['fr', 'de', 'en', 'da', 'pt-BR'],
};
---

<!doctype html>
<html lang={Astro.url.pathname.startsWith("/en") ? "en" : "fr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d0a" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={Astro.url.pathname.startsWith("/en") ? "en_GB" : "fr_FR"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />}
  </head>

  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-cream focus:px-4 focus:py-2 focus:text-night">
      Aller au contenu
    </a>
    <div class="relative z-[2]"><slot /></div>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Apparitions
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length && !reduce && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((t) => io.observe(t));
      }

      // Traînées pastel au déplacement du pointeur (désactivées sur tactile et si motion réduite).
      if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const canvas = document.createElement('canvas');
        canvas.className = 'pointer-trail';
        canvas.setAttribute('aria-hidden', 'true');
        Object.assign(canvas.style, {
          position: 'fixed', inset: '0', zIndex: '1',
          pointerEvents: 'none', mixBlendMode: 'screen',
        });
        document.body.append(canvas);
        const ctx = canvas.getContext('2d');
        if (ctx) {
          let width = 0, height = 0, raf = 0;
          const dpr = Math.min(devicePixelRatio || 1, 1.5);
          type Speck = { x: number; y: number; size: number; hue: number; life: number; rotation: number; sides: number; vx: number; vy: number };
          const specks: Speck[] = [];
          const resize = () => {
            width = innerWidth; height = innerHeight;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            canvas.style.width = width + 'px';
            canvas.style.height = height + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          };
          const colors = [148, 174, 48, 194, 22, 278];
          const draw = () => {
            ctx.clearRect(0, 0, width, height);
            for (let i = specks.length - 1; i >= 0; i--) {
              const p = specks[i];
              p.life -= 0.018;
              p.x += p.vx; p.y += p.vy;
              p.rotation += 0.012;
              if (p.life <= 0) { specks.splice(i, 1); continue; }
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate(p.rotation);
              ctx.beginPath();
              for (let j = 0; j < p.sides; j++) {
                const angle = (j / p.sides) * Math.PI * 2;
                const wobble = j % 2 ? 0.72 : 1.08;
                const radius = p.size * wobble * (0.88 + Math.sin(j * 2.3 + p.rotation) * 0.1);
                const x = Math.cos(angle) * radius;
                const y = Math.sin(angle) * radius * (0.65 + (j % 3) * 0.12);
                if (j === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
              }
              ctx.closePath();
              ctx.fillStyle = `hsla(${p.hue}, 88%, 67%, ${0.78 * p.life})`;
              ctx.fill();
              ctx.restore();
            }
            if (specks.length) raf = requestAnimationFrame(draw);
            else raf = 0;
          };
          addEventListener('pointermove', (event) => {
            // Plusieurs grains par mouvement : une traînée pointilliste, irrégulière et colorée.
            for (let i = 0; i < 5; i++) {
              specks.push({
                x: event.clientX + (Math.random() - 0.5) * 34,
                y: event.clientY + (Math.random() - 0.5) * 34,
                size: 2.2 + Math.random() * 5.8,
                hue: colors[Math.floor(Math.random() * colors.length)],
                life: 0.72 + Math.random() * 0.28,
                rotation: Math.random() * Math.PI,
                sides: 4 + Math.floor(Math.random() * 4),
                vx: (Math.random() - 0.5) * 0.45,
                vy: (Math.random() - 0.5) * 0.45,
              });
            }
            if (specks.length > 900) specks.splice(0, specks.length - 900);
            if (!raf) raf = requestAnimationFrame(draw);
          }, { passive: true });
          addEventListener('resize', resize, { passive: true });
          resize();
        }
      }

      // Parallaxe : chaque [data-speed] se décale selon sa distance au centre
      // de l'écran. speed > 0 = plus rapide que la page (premier plan),
      // speed < 0 = plus lent (arrière-plan).
      const layers = [...document.querySelectorAll<HTMLElement>('[data-speed]')];
      if (layers.length && !reduce) {
        let ticking = false;
        const update = () => {
          const mid = innerHeight / 2;
          for (const el of layers) {
            const r = el.parentElement!.getBoundingClientRect();
            const d = r.top + r.height / 2 - mid;
            el.style.transform = `translate3d(0, ${(-d * Number(el.dataset.speed)).toFixed(1)}px, 0)`;
          }
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }
    </script>
  </body>
</html>
