---
/**
 * Granular cursor layer.
 * Rendered once by BaseLayout and kept behind all page content.
 */
---

<canvas id="buffard-canvas" aria-hidden="true"></canvas>

<style is:global>
  #buffard-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('buffard-canvas') as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (canvas && !reduceMotion && finePointer) {
    const ctx = canvas.getContext('2d');

    if (ctx) {
      const hex = ['#ff6a2b', '#f4b6d2', '#b9a6f2', '#4aa8d8', '#2fa39a', '#1f7a5a', '#e8f23a'];
      const palette = hex.map((value) => [
        parseInt(value.slice(1, 3), 16),
        parseInt(value.slice(3, 5), 16),
        parseInt(value.slice(5, 7), 16),
      ]);

      let colorT = 0;
      const currentColor = () => {
        const index = Math.floor(colorT) % palette.length;
        const fraction = colorT - Math.floor(colorT);
        const smooth = fraction * fraction * (3 - 2 * fraction);
        const start = palette[index];
        const end = palette[(index + 1) % palette.length];
        return start.map((value, channel) =>
          Math.round(value + (end[channel] - value) * smooth),
        );
      };

      const tile = document.createElement('canvas');
      tile.width = tile.height = 200;
      const tileContext = tile.getContext('2d');
      let pattern: CanvasPattern | null = null;

      if (tileContext) {
        const noise = tileContext.createImageData(tile.width, tile.height);
        for (let i = 0; i < noise.data.length; i += 4) {
          noise.data[i] = noise.data[i + 1] = noise.data[i + 2] = 255;
          noise.data[i + 3] = 40 + Math.random() * 215;
        }
        tileContext.putImageData(noise, 0, 0);
      }

      let width = 0;
      let height = 0;
      let dpr = 1;
      let frameId = 0;
      let previousFrame = 0;

      const resize = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        pattern = tileContext ? ctx.createPattern(tile, 'repeat') : null;
        scheduleFrame();
      };

      const mouse = { x: 0, y: 0 };
      const position = { x: 0, y: 0 };
      const lastStamp = { x: 0, y: 0 };

      type Stamp = { x: number; y: number; radius: number; color: number[]; life: number };
      const trail: Stamp[] = [];
      const MAX_STAMPS = 700;
      const HEAD_RADIUS = 34;
      const STAMP_RADIUS = 22;
      const STEP = 5;
      const FADE_PER_SECOND = 1;

      let pointerInside = false;
      let pointerInitialized = false;

      const drawBlob = (x: number, y: number, radius: number, color: number[], alpha: number) => {
        const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
        gradient.addColorStop(0, `rgba(${color[0]},${color[1]},${color[2]},1)`);
        gradient.addColorStop(0.55, `rgba(${color[0]},${color[1]},${color[2]},0.6)`);
        gradient.addColorStop(1, `rgba(${color[0]},${color[1]},${color[2]},0)`);
        ctx.globalAlpha = alpha;
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();
      };

      const scheduleFrame = () => {
        if (!frameId) frameId = window.requestAnimationFrame(drawFrame);
      };

      const drawFrame = (now: number) => {
        frameId = 0;
        const deltaSeconds = previousFrame
          ? Math.min((now - previousFrame) / 1000, 0.05)
          : 1 / 60;
        previousFrame = now;

        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = 1;
        ctx.clearRect(0, 0, width, height);

        position.x += (mouse.x - position.x) * 0.12;
        position.y += (mouse.y - position.y) * 0.12;

        const dx = position.x - lastStamp.x;
        const dy = position.y - lastStamp.y;
        const distance = Math.hypot(dx, dy);

        if (distance >= STEP) {
          colorT += distance * 0.0005 + deltaSeconds * 0.00018;
          const color = currentColor();
          const steps = Math.floor(distance / STEP);
          for (let i = 1; i <= steps; i++) {
            const ratio = i / steps;
            trail.push({
              x: lastStamp.x + dx * ratio + (Math.random() - 0.5) * 2,
              y: lastStamp.y + dy * ratio + (Math.random() - 0.5) * 2,
              radius: STAMP_RADIUS + Math.random() * 8,
              color,
              life: 1,
            });
          }
          lastStamp.x = position.x;
          lastStamp.y = position.y;
          if (trail.length > MAX_STAMPS) trail.splice(0, trail.length - MAX_STAMPS);
        }

        const color = currentColor();

        for (let i = trail.length - 1; i >= 0; i--) {
          const stamp = trail[i];
          stamp.life -= deltaSeconds * FADE_PER_SECOND;
          if (stamp.life <= 0) {
            trail.splice(i, 1);
            continue;
          }
          drawBlob(
            stamp.x,
            stamp.y,
            stamp.radius * (1 - (1 - stamp.life) * 0.35),
            stamp.color,
            stamp.life * 0.28,
          );
        }

        if (pointerInside) drawBlob(position.x, position.y, HEAD_RADIUS, color, 0.9);

        if (pattern) {
          ctx.globalCompositeOperation = 'destination-in';
          ctx.globalAlpha = 1;
          ctx.fillStyle = pattern;
          ctx.fillRect(0, 0, width, height);
        }

        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = 1;

        const stillMoving = Math.hypot(mouse.x - position.x, mouse.y - position.y) > 0.5;
        if (stillMoving || trail.length > 0) scheduleFrame();
        else previousFrame = 0;
      };

      window.addEventListener('pointermove', (event) => {
        if (!pointerInitialized) {
          mouse.x = position.x = lastStamp.x = event.clientX;
          mouse.y = position.y = lastStamp.y = event.clientY;
          pointerInitialized = true;
        } else {
          mouse.x = event.clientX;
          mouse.y = event.clientY;
        }
        pointerInside = true;
        scheduleFrame();
      }, { passive: true });

      document.documentElement.addEventListener('pointerout', (event) => {
        if ((event as PointerEvent).relatedTarget === null) {
          pointerInside = false;
          scheduleFrame();
        }
      });

      window.addEventListener('blur', () => {
        pointerInside = false;
        scheduleFrame();
      });

      window.addEventListener('resize', resize, { passive: true });
      resize();
    }
  }
</script>
