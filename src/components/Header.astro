---
import { withBase } from '@/lib/url';

const isEnglish = Astro.url.pathname.startsWith('/en');
const nav = isEnglish ? [
  ['Profile', '/en.html#profil'], ['Studies', '/en.html#etudes'], ['Method', '/en.html#methode'], ['Experience', '/en.html#parcours'],
] : [
  ['Profil', '/#profil'],
  ['Études', '/#etudes'],
  ['Méthode', '/#methode'],
  ['Parcours', '/#parcours'],
];
---

<header data-site-header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-10 sm:pt-6 lg:px-[4.75rem]">
  <div class="mx-auto flex h-[4.25rem] max-w-[86rem] items-center justify-between rounded-full border border-cream/10 bg-coal/75 pl-3 pr-3 backdrop-blur-xl sm:h-[5.5rem] sm:pl-6 sm:pr-6">
    <a href={withBase('/')} class="flex items-center gap-3" aria-label="Accueil">
      <span class="grid size-11 place-items-center rounded-full bg-ember text-[0.95rem] font-semibold text-night">AV</span>
      <span class="hidden text-[1.05rem] font-medium text-cream xl:inline">Augustin Vinot-Marull</span>
    </a>
    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center justify-between gap-0 text-[1.35rem] text-cream">
        {nav.map(([label, href]) => (
          <li><a href={withBase(href)} class="nav-link whitespace-nowrap px-3 py-2 transition-colors">{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2"><a href={withBase(isEnglish ? '/' : '/en.html')} class="pill-line !px-4 !py-2.5 !text-sm" aria-label={isEnglish ? "Switch to French" : "Switch to English"}>{isEnglish ? "FR" : "EN"}</a><a href={withBase(isEnglish ? '/en.html#contact' : '/#contact')} class="pill-line !px-5 !py-2.5 !text-[1.35rem]">{isEnglish ? "Contact" : "Contact"} <span aria-hidden="true">→</span></a></div>
  </div>
</header>

<style>
  nav ul { min-width: min(42vw, 36rem); }
  nav li { display: flex; align-items: center; }
  nav li + li { border-left: 1px solid rgb(255 255 255 / 0.38); margin-left: clamp(0.7rem, 1.4vw, 1.4rem); padding-left: clamp(0.7rem, 1.4vw, 1.4rem); }
  .nav-link {
    display: inline-block;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 180ms ease;
  }
  .nav-link:hover, .nav-link:focus-visible { text-decoration-color: var(--color-ember); }
  @media (max-width: 900px) {
    nav ul { min-width: auto; }
    nav li + li { margin-left: 0.55rem; padding-left: 0.55rem; }
  }
</style>

<script>
  // Fade the header only after the first (hero) block has left the viewport.
  const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
  const heroBlock = document.querySelector<HTMLElement>('main > section:first-child');
  if (siteHeader && heroBlock) {
    let ticking = false;
    const updateHeaderVisibility = () => {
      const heroBottom = heroBlock.getBoundingClientRect().bottom;
      const fadeDistance = 180;
      const progress = Math.min(1, Math.max(0, -heroBottom / fadeDistance));
      siteHeader.style.opacity = String(1 - progress);
      siteHeader.style.pointerEvents = progress >= 1 ? 'none' : 'auto';
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateHeaderVisibility);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateHeaderVisibility();
  }
</script>
